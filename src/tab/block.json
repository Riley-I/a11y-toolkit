{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "a11y/tab",
	"version": "0.1.0",
	"title": "Tab",
	"category": "widgets",
	"icon": "text-page",
	"description": "A single tab and its panel. Use inside a Tabs block.",
	"parent": [ "a11y/tabs" ],
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".tab-title",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"textdomain": "a11y-toolkit",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css"
}
